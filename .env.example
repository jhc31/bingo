# Supabase > Project Settings > Database > Connection string > "Session pooler" (IPv4 compatible)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Any long random string; the web endpoint /api/cron/sync requires it in the X-Cron-Secret header
CRON_SECRET=change-me
